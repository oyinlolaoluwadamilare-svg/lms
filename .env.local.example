# Copy this file to .env.local (already gitignored - never commit real values) and fill in the
# secret values yourself. Nothing in .env.local should ever be pasted into chat or committed.

# Public - safe to expose to the browser (Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://qavodgltevkwqljafxmf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret - server-only. Never reference these with a NEXT_PUBLIC_ prefix, never send to a client
# component, never log. (Settings -> API in the Supabase dashboard.)
SUPABASE_SERVICE_ROLE_KEY=

# Secret - the direct (non-pooled) Postgres connection string, used only for running migrations
# (db/migrate.mjs) and the RLS test harness. Settings -> Database -> Connection string -> URI,
# on the "Direct connection" tab (port 5432), not the pgbouncer/pooled one (port 6543) - some DDL
# and the RLS harness's session-scoped set_config calls need a direct session, not a pooled one.
# Format: postgres://postgres:[YOUR-PASSWORD]@db.qavodgltevkwqljafxmf.supabase.co:5432/postgres
DATABASE_URL=
